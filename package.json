{
  "name": "bedocord-private-chat",
  "version": "0.1.0",
  "description": "Arkadaşlarınla aynı yerde. Özel masaüstü sohbeti.",
  "author": "Bedocord",
  "private": true,
  "type": "module",
  "main": "build/main.cjs",
  "scripts": {
    "test": "tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "build": "node scripts/build.mjs",
    "start": "electron .",
    "package": "npm run build && node scripts/package.mjs"
  },
  "build": {
    "appId": "local.bedocord.friends",
    "productName": "Bedocord",
    "directories": {
      "output": "release"
    },
    "files": [
      "build/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "node_modules/sql.js/dist/sql-wasm.wasm",
        "to": "sql-wasm.wasm"
      }
    ],
    "win": {
      "target": "dir",
      "signAndEditExecutable": false
    },
    "asar": true
  },
  "dependencies": {
    "lucide-react": "1.64.0",
    "node-forge": "1.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sql.js": "1.15.2",
    "ws": "8.22.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/node-forge": "1.3.14",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/sql.js": "1.4.11",
    "@types/ws": "8.18.2",
    "electron": "45.1.0",
    "esbuild": "0.28.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
